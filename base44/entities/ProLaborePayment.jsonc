{
  "name": "ProLaborePayment",
  "type": "object",
  "properties": {
    "socio_email": {
      "type": "string",
      "description": "Email do s\u00f3cio relacionado"
    },
    "socio_nome": {
      "type": "string",
      "description": "Nome do s\u00f3cio (desnormalizado)"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento (YYYY-MM-DD)"
    },
    "valor_pago": {
      "type": "number",
      "default": 0,
      "description": "Valor pago"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do pagamento"
    },
    "comprovante_url": {
      "type": "string",
      "description": "URL do comprovante"
    },
    "mes": {
      "type": "number",
      "description": "M\u00eas do pagamento (1-12)"
    },
    "ano": {
      "type": "number",
      "description": "Ano do pagamento"
    }
  },
  "required": [
    "socio_email",
    "data",
    "valor_pago"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.socio_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
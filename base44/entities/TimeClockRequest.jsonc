{
  "name": "TimeClockRequest",
  "type": "object",
  "properties": {
    "timeclock_id": {
      "type": "string",
      "description": "ID do registro de ponto relacionado"
    },
    "date": {
      "type": "string",
      "description": "Data do ponto (YYYY-MM-DD)"
    },
    "employee_email": {
      "type": "string",
      "description": "Email do colaborador"
    },
    "employee_name": {
      "type": "string",
      "description": "Nome do colaborador"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "justification",
        "correction"
      ],
      "description": "Tipo de solicita\u00e7\u00e3o"
    },
    "clock_type": {
      "type": "string",
      "enum": [
        "entry",
        "break",
        "return",
        "exit"
      ],
      "description": "Tipo de batida"
    },
    "reason": {
      "type": "string",
      "description": "Motivo/justificativa"
    },
    "old_time": {
      "type": "string",
      "description": "Hor\u00e1rio original (HH:mm)"
    },
    "new_time": {
      "type": "string",
      "description": "Novo hor\u00e1rio solicitado (HH:mm)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notas do administrador"
    }
  },
  "required": [
    "date",
    "employee_email",
    "request_type",
    "clock_type",
    "reason"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.employee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.employee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Socio",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do s\u00f3cio"
    },
    "email": {
      "type": "string",
      "description": "Email do s\u00f3cio (usado para acesso)"
    },
    "valor_mensal": {
      "type": "number",
      "default": 0,
      "description": "Valor do Pr\u00f3-Labore Mensal (Meta)"
    },
    "saldo_acumulado": {
      "type": "number",
      "default": 0,
      "description": "Saldo Acumulado"
    }
  },
  "required": [
    "nome",
    "email",
    "valor_mensal"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
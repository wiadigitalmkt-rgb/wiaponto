# ==============================================================================
# FUNÇÃO DO ARQUIVO: Lista de arquivos e pastas que o Git deve IGNORAR.
# - Protege senhas e chaves secretas para não subirem para o GitHub.
# - Evita enviar pastas pesadas de dependências e arquivos temporários.
# ==============================================================================

# Oculta arquivos de variáveis de ambiente (contêm senhas e chaves do Supabase/APIs)
.env
.env.*

# Ignora registros de erros e logs de execução
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Ignora pastas de pacotes instalados e builds compilados
node_modules
dist
dist-ssr
*.local

# Ignora configurações pessoais dos editores de código (VS Code, Visual Studio, etc.)
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Caches temporários do Vite
.vite

{
  "name": "FinancialRecord",
  "type": "object",
  "properties": {
    "employee_email": {
      "type": "string"
    },
    "month": {
      "type": "number"
    },
    "year": {
      "type": "number"
    },
    "base_salary": {
      "type": "number",
      "default": 0
    },
    "discounts_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "extra_payments_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "default": [],
      "description": "Pagamentos de horas extras efetuados separadamente do sal\u00e1rio"
    },
    "extra_total_override": {
      "type": "number",
      "default": 0,
      "description": "Valor manual do total de extras (sobrep\u00f5e o c\u00e1lculo autom\u00e1tico quando maior que zero)"
    }
  },
  "required": [
    "employee_email",
    "month",
    "year"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.employee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}